# Copy this file to .env and replace the value below with your own secret.
# .env is in .gitignore: it never goes to GitHub. This file does, which is
# why it holds a placeholder rather than a real secret.
#
# One way to make a good secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET="replace-me-with-a-long-random-string"

# Where the client runs. The server lets browsers on this origin call it
# (we wire that up in week 7).
CLIENT_ORIGIN="http://localhost:5173"

# The rest have defaults that work on your laptop. Set them on the server.

# The port Express (and socket.io) listen on.
PORT=6790

# Where MongoDB is, and which database to use.
MONGO_URI="mongodb://127.0.0.1:27017"
DB_NAME="week9"
